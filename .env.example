# ====================================
# YouTube Playlist Study Assistant
# Environment Configuration
# ====================================

# --- Required ---
# Groq API Key (get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# --- Embeddings (choose one) ---
# Option 1: Leave blank to use FREE local embeddings (all-MiniLM-L6-v2, 384 dims)
# Option 2: Set OpenAI key for higher quality embeddings (text-embedding-3-small, 1536 dims)
OPENAI_API_KEY=

# --- YouTube (optional) ---
# YouTube Data API v3 key (optional - the app can extract playlist data without it)
YOUTUBE_API_KEY=

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Vector DB Mode ---
# "local" = zero-setup file-backed vector DB (default)
# "qdrant" = Qdrant cloud or self-hosted
# "pinecone" = Pinecone serverless
VECTOR_DB_MODE=local

# Qdrant (if VECTOR_DB_MODE=qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# Pinecone (if VECTOR_DB_MODE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=
